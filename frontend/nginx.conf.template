# ${BACKEND_URL} is filled in at container start (e.g. http://backend:8080).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Liveness/readiness for the container itself.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API and the Server-Sent Events stream go to the backend.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE: no buffering (events must reach the browser immediately), no keep-alive "close"
        # header, and a long read timeout (the backend sends a keepalive comment every 15 s).
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # Hashed asset files never change: cache them for a year. index.html must not be cached.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
